# Private backend only. Obtain real credentials from CCAvenue M.A.R.S.
PAYMENT_MODE=test
ENABLE_LIVE_PAYMENTS=false
# Set true only after validating this adapter against your merchant integration/API kit.
CCAVENUE_KIT_VERIFIED=false
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=
# Status API credentials can differ; confirm IP registration with CCAvenue.
CCAVENUE_API_ACCESS_CODE=
CCAVENUE_API_WORKING_KEY=
ALLOWED_ORIGIN=https://instantprofessionals.in
PAYMENT_PUBLIC_ORIGIN=
# Absolute filename on private persistent disk outside the public checkout.
PAYMENT_DB_PATH=
HOST=127.0.0.1
PORT=3001

# Cloud Run entrypoint: cloud-server.mjs (does not use PAYMENT_DB_PATH).
# Separate restricted PostgreSQL login; keep password in Secret Manager.
PAYMENT_SQL_HOST=
PAYMENT_SQL_DATABASE=
PAYMENT_SQL_USER=
PAYMENT_SQL_PASSWORD=
PAYMENT_SQL_SSL=true
PAYMENT_SQL_PORT=5432
